# Copy this file to .env.local and fill in what you need.
# Zero-credential local dev needs nothing beyond the two lines below -
# see README.md.

# Postgres connection string, or a local PGlite store for zero-credential dev:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
#   DATABASE_URL=pglite:.data/db       (persists to a local directory)
#   DATABASE_URL=pglite:memory         (in-memory, used by tests)
DATABASE_URL=pglite:.data/db

# Where NAV history (one gzipped JSON per scheme) is read from and written to.
#   NAV_STORE=fs:.data/nav             (local filesystem, zero credentials)
#   NAV_STORE=supabase                (private Supabase Storage bucket)
#   NAV_STORE=r2                       (Cloudflare R2; requires R2_* below)
NAV_STORE=fs:.data/nav

# Required when NAV_STORE=supabase. Server-only; never use NEXT_PUBLIC_*.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=fund-nav
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.

# Required only when NAV_STORE=r2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Single configurable risk-free rate used across all risk-ratio metrics
# (Sharpe, Sortino, alpha, etc.). Defaults to 0.065 (6.5%) if unset.
# RISK_FREE_RATE=0.065
